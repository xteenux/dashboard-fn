# Contoh environment variables. Copy jadi .env lalu sesuaikan.

# SQLite database (relatif ke folder prisma/)
DATABASE_URL="file:./dev.db"

# Secret untuk signed session JWT NextAuth. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Optional: URL aplikasi (default http://localhost:3000)
# AUTH_URL="http://localhost:3000"
